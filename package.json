{
  "name": "schoolhouse-arcade",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "description": "Schoolhouse Arcade — a retro coin-op arcade of small learning games, with tickets, badges and real prizes",
  "scripts": {
    "dev": "npm --prefix web run dev",
    "test": "node --test --test-timeout=300000 \"web/shared/**/*.test.ts\" \"web/server/**/*.test.ts\" \"scripts/tests/*.test.mjs\"",
    "lint": "npm --prefix web run lint",
    "typecheck": "cd web && npx tsc -b",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db/setup.mjs --migrate-only",
    "db:setup": "node scripts/db/setup.mjs",
    "pin:reset": "node scripts/db/pin-reset.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11"
  }
}
